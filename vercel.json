{
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/conditions", "destination": "/conditions.html" },
    { "source": "/mentions-legales", "destination": "/mentions-legales.html" },
    { "source": "/privacy-en", "destination": "/privacy-en.html" },
    { "source": "/conditions-en", "destination": "/conditions-en.html" },
    { "source": "/mentions-legales-en", "destination": "/mentions-legales-en.html" },
    { "source": "/privacy-en-gb", "destination": "/privacy-en-gb.html" },
    { "source": "/conditions-en-gb", "destination": "/conditions-en-gb.html" },
    { "source": "/mentions-legales-en-gb", "destination": "/mentions-legales-en-gb.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
